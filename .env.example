# ===== PostgreSQL =====
POSTGRES_USER=sophos
POSTGRES_PASSWORD=sophos_dev
POSTGRES_DB=sophos

# 开发模式下 Sophos 从主机连接容器里的 PG
# 生产模式下容器间通信用 compose 内部 DNS，见 compose.prod.yml
# 注意：使用 asyncpg 驱动，scheme 为 postgresql://（不含 +asyncpg）
DATABASE_URL=postgresql://sophos:sophos_dev@localhost:5432/sophos

# ===== NapCat =====
# 容器内进程的 UID/GID，设为你当前用户以保持文件权限一致
# macOS/Linux 下执行 id -u 和 id -g 获取
NAPCAT_UID=
NAPCAT_GID=
# QQ 号（可选，留空则启动后在 WebUI 扫码登录）
NAPCAT_ACCOUNT=
# WebUI 密码：首次启动后执行 docker compose logs napcat 查看，登录后可在 WebUI 中修改

# 开发模式下 Sophos 从主机连接容器里的 NapCat WS
# 生产模式下容器间通信用 compose 内部 DNS，见 compose.prod.yml
ONEBOT_WS_URL=ws://localhost:3001
# NapCat WebSocket 鉴权 token（在 NapCat WebUI 的网络配置中设置）
ONEBOT_WS_TOKEN=

# ===== Bot 身份 =====
# Bot 登录的 QQ 号（用于触发判断等场景）
BOT_ID=
# Bot 的昵称（用于触发判断，如被提及时识别自身）
BOT_NICKNAME=

# ===== Sophos 应用配置 =====
# 每个会话（群聊/私聊）查询时返回的最大消息条数
MAX_CONTEXT_MESSAGES=50
# 喂给 LLM 时转换时间戳用的 UTC 偏移（小时）
TIMEZONE_OFFSET=8
# 是否将同账号其他来源的消息（其他 bot、手动发的等）纳入 LLM 上下文
INCLUDE_CO_ACCOUNT_IN_CONTEXT=true

# ===== LLM =====
# OpenAI 兼容 API 地址（如 https://api.openai.com/v1, https://api.deepseek.com/v1）
LLM_BASE_URL=
# API Key
LLM_API_KEY=
# 模型名（如 gpt-4o, deepseek-chat）
LLM_MODEL=
# 生成温度（0.0-2.0）
LLM_TEMPERATURE=0.7
# 最大生成 token 数
LLM_MAX_TOKENS=4096
# 上下文降级：开启后将多轮消息合并为单条 user message，兼容不支持连续 user message 的模型
LLM_FLATTEN_CONTEXT=false
# HTTP 请求超时（秒）
LLM_REQUEST_TIMEOUT=60
# Tool calling 最大循环轮次
LLM_MAX_TOOL_ROUNDS=10
# 流式请求（避免超时，部分 provider 不兼容时设为 false）
LLM_STREAM=true
# 额外请求体参数（JSON），合并到每次 LLM 请求中
# 例如 Gemini 关闭 thinking：{"reasoning_effort":"none"}
LLM_EXTRA_BODY=
# 用户消息格式模板，可用占位符：{{time}} {{mid}} {{name}} {{uid}} {{message}}
LLM_USER_SCHEMA=[{{time}}] #{{mid}} {{name}}({{uid}})：{{message}}
# Bot 消息格式模板（仅拍平模式使用）
LLM_BOT_SCHEMA=[{{time}}] #{{mid}} {{name}}：{{message}}

# ===== 跨 Context =====
# 跨 context 背景注入模式：system / inline / off
CROSS_CONTEXT_MODE=system
