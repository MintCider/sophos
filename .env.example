# ===== PostgreSQL =====
POSTGRES_USER=sophos
POSTGRES_PASSWORD=sophos_dev
POSTGRES_DB=sophos

# 开发模式下 Sophos 从主机连接容器里的 PG
# 生产模式下容器间通信用 compose 内部 DNS，见 compose.prod.yml
# 注意：使用 asyncpg 驱动，scheme 为 postgresql://（不含 +asyncpg）
DATABASE_URL=postgresql://sophos:sophos_dev@localhost:5432/sophos

# ===== NapCat =====
# 容器内进程的 UID/GID，设为你当前用户以保持文件权限一致
# macOS/Linux 下执行 id -u 和 id -g 获取
NAPCAT_UID=
NAPCAT_GID=
# QQ 号（可选，留空则启动后在 WebUI 扫码登录）
NAPCAT_ACCOUNT=
# WebUI 密码：首次启动后执行 docker compose logs napcat 查看，登录后可在 WebUI 中修改

# 开发模式下 Sophos 从主机连接容器里的 NapCat WS
# 生产模式下容器间通信用 compose 内部 DNS，见 compose.prod.yml
ONEBOT_WS_URL=ws://localhost:3001
# NapCat WebSocket 鉴权 token（在 NapCat WebUI 的网络配置中设置）
ONEBOT_WS_TOKEN=

# ===== Bot 身份 =====
# Bot 登录的 QQ 号（用于触发判断等场景）
BOT_ID=
# Bot 的昵称（用于触发判断，如被提及时识别自身）
BOT_NICKNAME=

# ===== 权限 =====
# Master QQ 号（逗号分隔，拥有所有权限）
MASTER_QQ=

# ===== Sophos 应用配置 =====
# 每个会话（群聊/私聊）查询时返回的最大消息条数
MAX_CONTEXT_MESSAGES=50
# 喂给 LLM 时转换时间戳用的 UTC 偏移（小时）
TIMEZONE_OFFSET=8
# 是否将同账号其他来源的消息（其他 bot、手动发的等）纳入 LLM 上下文
INCLUDE_CO_ACCOUNT_IN_CONTEXT=true

# ===== LLM Provider（首次启动 seed 用）=====
# 以下 6 项仅在 DB 无 provider 时自动创建 "default" provider。
# 之后通过 .llm 命令管理（添加/切换/删除 provider），不再读取这些值。
# OpenAI 兼容 API 地址（如 https://api.openai.com/v1, https://api.deepseek.com/v1）
LLM_BASE_URL=
# API Key
LLM_API_KEY=
# 模型名（如 gpt-4o, deepseek-chat）
LLM_MODEL=
# 流式请求（避免超时，部分 provider 不兼容时设为 false）
LLM_STREAM=true
# 额外请求体参数（JSON），合并到每次 LLM 请求中
# 例如 Gemini 关闭 thinking：{"reasoning_effort":"none"}
LLM_EXTRA_BODY=
# HTTP 请求超时（秒）
LLM_REQUEST_TIMEOUT=60
# API 类型：openai（默认）或 gemini（使用 Gemini 原生 API）
LLM_API_TYPE=openai

# ===== LLM 全局行为参数（始终从 .env 读取）=====
# 生成温度（0.0-2.0）
LLM_TEMPERATURE=0.7
# 最大生成 token 数
LLM_MAX_TOKENS=4096
# 上下文降级：开启后将多轮消息合并为单条 user message，兼容不支持连续 user message 的模型
LLM_FLATTEN_CONTEXT=false
# Tool calling 最大循环轮次
LLM_MAX_TOOL_ROUNDS=10
# 用户消息格式模板，可用占位符：{{time}} {{mid}} {{name}} {{uid}} {{message}}
LLM_USER_SCHEMA=[{{time}}] #{{mid}} {{name}}({{uid}})：{{message}}
# Bot 消息格式模板（仅拍平模式使用）
LLM_BOT_SCHEMA=[{{time}}] #{{mid}} {{name}}：{{message}}

# ===== 跨 Context =====
# 跨 context 背景注入模式：system / inline / off
CROSS_CONTEXT_MODE=system

# ===== Vision Provider（首次启动 seed 用）=====
# 以下 6 项仅在 DB 无 'vision' slot 时自动创建。
# 之后通过 .llm vision 命令管理，不再读取这些值。
# 留空则不启用图片识别（降级为 [图片] 占位符）。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_STREAM=false
VISION_EXTRA_BODY=
VISION_REQUEST_TIMEOUT=30
# API 类型：openai（默认）或 gemini
VISION_API_TYPE=openai

# ===== Trigger LLM Provider（首次启动 seed 用）=====
# 轻量级 LLM 用于判断是否需要回复（留空则不启用 LLM 触发）
# 之后通过 .llm trigger 命令管理，不再读取这些值。
TRIGGER_BASE_URL=
TRIGGER_API_KEY=
TRIGGER_MODEL=
TRIGGER_STREAM=false
TRIGGER_EXTRA_BODY=
TRIGGER_REQUEST_TIMEOUT=15
TRIGGER_API_TYPE=openai

# ===== Embedding Provider（首次启动 seed 用）=====
# 以下 4 项仅在 DB 无 'embedding' slot 时自动创建。
# 之后通过 .memory model 命令管理，不再读取这些值。
# 留空则不启用记忆系统的向量检索功能。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# API endpoint 后缀（默认 /embeddings，火山引擎多模态用 /embeddings/multimodal）
EMBEDDING_ENDPOINT=/embeddings
# 额外请求体参数（JSON），合并到每次 embedding 请求中
# 例如降维：{"dimensions": 1024}
EMBEDDING_EXTRA_BODY=
EMBEDDING_REQUEST_TIMEOUT=30

# ===== Vision 全局行为参数（始终从 .env 读取）=====
# VLM 首次识别图片时的 system prompt
VISION_SYSTEM_PROMPT=以下是出现在群聊中的一张图片。请用简练的中文概括图像内容，尽可能覆盖值得注意的特征。首先给出图片类型（如：照片、表情包、梗图、截图、漫画、二次元人物等），然后描述内容。如果是表情包或梗图，描述其含义和情感。如果有文字，转录文字内容。如果图片是多帧网格（多张小图拼成的网格），说明原图是动图/GIF，请描述动画内容和变化过程。你只需要进行描述，不要做出任何进一步的补充、解释、推断或反馈。
# VLM 再次识别时的 refine prompt（{prev_description} 会被替换为上次描述）
VISION_REFINE_PROMPT=之前对这张图片的描述是：{prev_description}\n请重新审视图片，如果描述准确则保持不变，如果有遗漏或错误请修正。同样只需描述，不要做进一步补充。
# 喂给 VLM 的最近聊天消息数
VISION_CONTEXT_MESSAGES=5
# ε-greedy 衰减参数（控制探索/利用平衡）
VISION_EPSILON_INIT=1.0
VISION_EPSILON_MIN=0.0
VISION_EPSILON_DECAY=0.7
# imagehash 的 hash_size 参数
VISION_HASH_SIZE=15
# VLM 最大生成 token 数
VISION_MAX_TOKENS=1024

# ── WebUI API ──────────────────────────────────────────
# ── WebUI API ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# WebUI 登录密码（留空则任何人可访问，未来将限制为仅 localhost）
WEBUI_PASSWORD=
